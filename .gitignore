**/secret.conf

# Private keys — never commit one. A stray `git add -A` over a local harness
# directory (e.g. the AWS bench rig's SSH key) is how these escape.
# The clickhouse test certs below were already tracked when this rule landed;
# ignore rules do not apply to tracked files, so the exceptions only record
# that those two are deliberate rather than oversights.
*.pem
*.key
!scripts/clickhouse/testing.cert.pem
!scripts/clickhouse/testing.cert.key

# bloop and metals
.bloop
.bsp

# metals
project/metals.sbt
.metals

